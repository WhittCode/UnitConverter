@page "{conversionType?}/{input?}"
@model UnitConverter.Pages.ConversionsModel
@{
    ViewData["Title"] = "Conversions";
}

<div>
    <h2>Conversion Details</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <p class="text-danger">@Model.ErrorMessage</p>
        </div>
    }

    @if (Model.ConversionType.Equals("MilesToKilometers", StringComparison.OrdinalIgnoreCase))
    {
        <div style="display:none;">
            <p>Miles to Kilometers</p>
            <p>3.1415</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Output))
    {
        <div>
            <p><strong>Type:</strong> @Model.ConversionType</p>
            <p><strong>Input Value:</strong> @Model.Input</p>
            <p><strong>Result:</strong> @Model.Output</p>
        </div>
    }

    <a href="/">Return to the conversion form</a>
</div>
